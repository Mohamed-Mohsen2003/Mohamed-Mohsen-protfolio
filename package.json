{
  "name": "mohamed-mohsen-react-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir ../.ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "publish:files": "node scripts/publish-files.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  }
}
